datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrganizationType {
  SUPPLIER
  RECIPIENT
  LOGISTICS_PARTNER
  ADMIN_HQ
}

enum UserRole {
  ADMIN
  SUPPLIER
  MITRA
}

enum FoodCategory {
  COOKED_MEALS
  BAKERY_PASTRY
  DAIRY_EGGS
  FRESH_PRODUCE
  PACKAGED_DRY
  BEVERAGES
}

enum FoodCondition {
  FRESH
  SLIGHTLY_WILTED
  NEAR_EXPIRY
  DAMAGED_PACKAGING
  SPOILED
}

enum PackagingStatus {
  INTACT_SEALED
  RESEALED
  OPENED_EXPOSED
  DAMAGED
}

enum ListingLifecycleStatus {
  REPORTED
  ASSESSED
  MATCHED
  CANCELLED
  EXPIRED
  RECEIVED
}

enum FoodSafetyStatus {
  PASS
  REVIEW
  REJECT
}

enum RouteHierarchy {
  REDISTRIBUTE
  PROCESS
  ANIMAL_FEED
  ORGANIC
  SAFE_DISPOSAL
}

enum RecipientType {
  COMMUNITY_KITCHEN
  FOOD_BANK
  ORPHANAGE
  COMPOST_FACILITY
}

enum JourneyStatus {
  MATCHED
  RESCUE_INITIATED
  RECEIVED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  CANCEL
  PHYSICAL_REJECTION
  DELETE
}

model Organization {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(255)
  type             OrganizationType
  address          String
  contactPhone     String?          @map("contact_phone") @db.VarChar(50)
  isVerified       Boolean          @default(false) @map("is_verified")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  users            User[]
  surplusListings  SurplusListing[] @relation("DonorListings")
  recipientProfile RecipientProfile?

  @@map("organizations")
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  email          String        @unique @db.VarChar(255)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  fullName       String        @map("full_name") @db.VarChar(255)
  role           UserRole
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  reportedListings SurplusListing[] @relation("ReportedListings")
  timelineEvents JourneyTimelineEvent[]
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model FoodType {
  id                    String       @id @default(uuid()) @db.Uuid
  code                  String       @unique @db.VarChar(100)
  nameId                String       @map("name_id") @db.VarChar(255)
  nameEn                String       @map("name_en") @db.VarChar(255)
  defaultCategory       FoodCategory @map("default_category")
  maxSafeHours          Decimal      @map("max_safe_hours") @db.Decimal(5, 2)
  recommendedTempMinC   Decimal?     @map("recommended_temp_min_c") @db.Decimal(4, 1)
  recommendedTempMaxC   Decimal?     @map("recommended_temp_max_c") @db.Decimal(4, 1)
  isPerishable          Boolean      @default(true) @map("is_perishable")
  createdAt             DateTime     @default(now()) @map("created_at")

  surplusListings       SurplusListing[]

  @@map("food_types")
}

model SurplusListing {
  id                     String                 @id @default(uuid()) @db.Uuid
  donorOrganizationId    String                 @map("donor_organization_id") @db.Uuid
  reporterUserId         String                 @map("reporter_user_id") @db.Uuid
  foodTypeId             String?                @map("food_type_id") @db.Uuid
  foodName               String                 @map("food_name") @db.VarChar(255)
  foodCategory           FoodCategory           @map("food_category")
  quantityKg             Decimal                @map("quantity_kg") @db.Decimal(10, 2)
  portions               Int
  condition              FoodCondition
  storageTemperatureC    Decimal?               @map("storage_temperature_c") @db.Decimal(4, 1)
  packagingStatus        PackagingStatus        @map("packaging_status")
  hygieneScore           Int                    @map("hygiene_score")
  preparedAt             DateTime               @map("prepared_at")
  safeUntilTimestamp     DateTime               @map("safe_until_timestamp")
  notes                  String?
  currentLifecycleStatus ListingLifecycleStatus @default(REPORTED) @map("current_lifecycle_status")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  donorOrganization      Organization           @relation("DonorListings", fields: [donorOrganizationId], references: [id], onDelete: Restrict)
  reporterUser           User                   @relation("ReportedListings", fields: [reporterUserId], references: [id], onDelete: Restrict)
  foodType               FoodType?              @relation(fields: [foodTypeId], references: [id], onDelete: SetNull)
  safetyAssessment       FoodSafetyAssessment?
  scoreAssessment        RescueScoreAssessment?
  journeys               RescueJourney[]

  @@index([donorOrganizationId])
  @@index([currentLifecycleStatus])
  @@index([safeUntilTimestamp])
  @@map("surplus_listings")
}

model FoodSafetyAssessment {
  id                   String           @id @default(uuid()) @db.Uuid
  listingId            String           @unique @map("listing_id") @db.Uuid
  safetyStatus         FoodSafetyStatus @map("safety_status")
  gateReasons          Json             @map("gate_reasons")
  storageHistoryKnown  Boolean          @default(true) @map("storage_history_known")
  isExpired            Boolean          @default(false) @map("is_expired")
  hasSpoilageSigns     Boolean          @default(false) @map("has_spoilage_signs")
  packagingDamaged     Boolean          @default(false) @map("packaging_damaged")
  hygieneAdequate      Boolean          @default(true) @map("hygiene_adequate")
  tempAbuseDetected    Boolean          @default(false) @map("temp_abuse_detected")
  assessedAt           DateTime         @default(now()) @map("assessed_at")

  listing              SurplusListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([safetyStatus])
  @@map("food_safety_assessments")
}

model RescueScoreAssessment {
  id                    String         @id @default(uuid()) @db.Uuid
  listingId             String         @unique @map("listing_id") @db.Uuid
  totalScore            Decimal        @map("total_score") @db.Decimal(5, 2)
  conditionSubscore     Decimal        @map("condition_subscore") @db.Decimal(5, 2)
  urgencySubscore       Decimal        @map("urgency_subscore") @db.Decimal(5, 2)
  quantitySubscore      Decimal        @map("quantity_subscore") @db.Decimal(5, 2)
  easeSubscore          Decimal        @map("ease_subscore") @db.Decimal(5, 2)
  destinationFitSubscore Decimal       @map("destination_fit_subscore") @db.Decimal(5, 2)
  recommendedRoute      RouteHierarchy @map("recommended_route")
  scoreBreakdown        Json           @map("score_breakdown")
  calculatedAt          DateTime       @default(now()) @map("calculated_at")

  listing               SurplusListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([totalScore])
  @@index([recommendedRoute])
  @@map("rescue_score_assessments")
}

model RecipientProfile {
  id                     String           @id @default(uuid()) @db.Uuid
  organizationId         String           @unique @map("organization_id") @db.Uuid
  recipientType          RecipientType    @map("recipient_type")
  acceptedFoodCategories Json             @map("accepted_food_categories")
  hasRefrigeration       Boolean          @default(false) @map("has_refrigeration")
  hasFreezer             Boolean          @default(false) @map("has_freezer")
  dailyMaxCapacityKg     Decimal          @map("daily_max_capacity_kg") @db.Decimal(10, 2)
  latitude               Decimal          @db.Decimal(9, 6)
  longitude              Decimal          @db.Decimal(9, 6)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capacities             RecipientCapacity[]
  journeys               RescueJourney[]

  @@map("recipient_profiles")
}

model RecipientCapacity {
  id                  String           @id @default(uuid()) @db.Uuid
  recipientId         String           @map("recipient_id") @db.Uuid
  capacityDate        DateTime         @map("capacity_date") @db.Date
  maxCapacityKg       Decimal          @map("max_capacity_kg") @db.Decimal(10, 2)
  allocatedCapacityKg Decimal          @default(0) @map("allocated_capacity_kg") @db.Decimal(10, 2)
  receivedCapacityKg  Decimal          @default(0) @map("received_capacity_kg") @db.Decimal(10, 2)
  availableCapacityKg Decimal          @map("available_capacity_kg") @db.Decimal(10, 2)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  recipient           RecipientProfile @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, capacityDate])
  @@index([capacityDate])
  @@map("recipient_capacities")
}

model RescueJourney {
  id                       String          @id @default(uuid()) @db.Uuid
  listingId                String          @map("listing_id") @db.Uuid
  recipientId              String          @map("recipient_id") @db.Uuid
  currentStatus            JourneyStatus   @default(MATCHED) @map("current_status")
  assignedAt               DateTime        @default(now()) @map("assigned_at")
  initiatedAt              DateTime?       @map("initiated_at")
  receivedAt               DateTime?       @map("received_at")
  cancelledAt              DateTime?       @map("cancelled_at")
  cancellationReason       String?         @map("cancellation_reason")
  estimatedTransitMinutes  Int?            @map("estimated_transit_minutes")
  actualReceivedKg         Decimal?        @map("actual_received_kg") @db.Decimal(10, 2)
  notes                    String?
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  listing                  SurplusListing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  recipient                RecipientProfile @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  timelineEvents           JourneyTimelineEvent[]

  @@index([listingId])
  @@index([recipientId])
  @@index([currentStatus])
  @@map("rescue_journeys")
}

model JourneyTimelineEvent {
  id          String        @id @default(uuid()) @db.Uuid
  journeyId   String        @map("journey_id") @db.Uuid
  status      JourneyStatus
  note        String?
  actorUserId String?       @map("actor_user_id") @db.Uuid
  timestamp   DateTime      @default(now())

  journey     RescueJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  actorUser   User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([journeyId])
  @@map("journey_timeline_events")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  tableName     String      @map("table_name") @db.VarChar(100)
  recordId      String      @map("record_id") @db.Uuid
  action        AuditAction
  actorUserId   String?     @map("actor_user_id") @db.Uuid
  previousState Json?       @map("previous_state")
  newState      Json?       @map("new_state")
  reason        String?
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  timestamp     DateTime    @default(now())

  actorUser     User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@index([actorUserId])
  @@index([timestamp])
  @@map("audit_logs")
}
